# App
APP_NAME="Nutrition AI API"
PRODUCTION_MODE=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database
DATABASE_URL=postgresql+asyncpg://nutrition_ai:nutrition_ai_password@db:5432/nutrition_ai

# Supabase Auth JWT validation
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHM=HS256

# Optional Supabase Storage
STORAGE_ENABLED=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=nutrition-labels
STORAGE_SIGNED_URL_TTL_SECONDS=900

# Optional external services
OCR_SERVICE_URL=
INFERENCE_SERVICE_URL=
EMBEDDING_SERVICE_URL=
EXTERNAL_SERVICE_TIMEOUT_SECONDS=20
EXTERNAL_RETRY_ATTEMPTS=2

# Rate limiting and request limits
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=10485760

# Feature limits
MAX_QUESTION_CHARS=1000
MAX_COMPARE_IMAGES=5
